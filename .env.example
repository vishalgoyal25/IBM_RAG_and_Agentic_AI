# Copy this file to `.env` and fill in your own keys.
#   cp .env.example .env        (bash)
#   Copy-Item .env.example .env (PowerShell)
#
# `.env` is git-ignored. Never commit real keys.
# Load in code with:  from dotenv import load_dotenv; load_dotenv()

# ---------- IBM watsonx.ai ----------
# https://dataplatform.cloud.ibm.com  ->  API keys / Project
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ---------- OpenAI ----------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: override for proxies / compatible endpoints
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- Hugging Face ----------
# https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=

# ---------- Other model providers (optional) ----------
# Used by some labs and by CrewAI/LiteLLM examples
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ---------- Agent tools (optional) ----------
# Web search tools used in agent labs
TAVILY_API_KEY=
SERPER_API_KEY=

# ---------- Tracing / observability (optional) ----------
# LangSmith: https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=IBM_RAG_and_Agentic_AI

# ---------- Local paths ----------
CHROMA_PERSIST_DIR=./chroma_db
FAISS_INDEX_DIR=./faiss_index
